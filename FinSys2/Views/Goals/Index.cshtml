@model List<FinSys2.Models.Goal>
@{
    ViewData["Title"] = "Цели";
    decimal freeCash = ViewBag.FreeCash ?? 0;
    
    var sortedGoals = Model.OrderBy(g =>
    {
        decimal current = Math.Min((freeCash * g.AllocatedPercentage) / 100, g.TargetAmount);
        return current >= g.TargetAmount ? 1 : 0;
    }).ToList();
}

<div class="row">
    <div class="col-md-4">
        <div class="card p-4 shadow-sm border-0 mb-4">
            <h4 class="mb-3 text-primary">Новая цель 🎯</h4>
            <form asp-action="AddGoal" method="post">
                <div class="mb-3">
                    <input type="text" name="title" class="form-control border-sky" placeholder="На что копим?" required>
                </div>
                <div class="mb-3">
                    <input type="number" name="targetAmount" class="form-control border-sky" placeholder="Сумма ₽" required>
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted small">Доля свободных денег: <span id="pVal" class="fw-bold text-primary">50</span>%</label>
                    <input type="range" name="percentage" class="form-range" min="0" max="100" step="1" id="pRange" value="50" oninput="pVal.innerText = this.value">
                </div>
                <button type="submit" class="btn btn-sky w-100 fw-bold">Создать</button>
            </form>
        </div>
        
        <div class="card p-4 shadow-sm border-0 bg-light">
            <h6 class="text-muted mb-3 fw-bold">Курсы валют (ЦБ РФ)</h6>
            @if (ViewBag.Rates != null)
            {
                @foreach (var rate in ViewBag.Rates)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span>@rate.Key</span> <strong>@rate.Value</strong>
                    </div>
                }
            }
        </div>
    </div>

    <div class="col-md-8">
        <div class="alert alert-info border-0 shadow-sm mb-4">
            Свободных денег для распределения: <strong>@freeCash.ToString("N2") ₽</strong>
        </div>

        <div class="row">
            @{
                //сначала активные, выполненные уходят в самый низ
                var displayGoals = Model.OrderBy(g => g.IsCompleted ? 1 : 0).ToList();
            }

            @foreach (var goal in displayGoals)
            {
                //Если цель завершена, считаем, что накоплено 100%
                decimal saved = goal.IsCompleted ? goal.TargetAmount : Math.Min((freeCash * goal.AllocatedPercentage) / 100, goal.TargetAmount);
                if (saved < 0) saved = 0;
            
                decimal progress = (saved / goal.TargetAmount) * 100;
            
                //Флаг для кнопки
                bool isReadyToComplete = !goal.IsCompleted && saved >= goal.TargetAmount;

                <div class="col-md-6 mb-4">
                    <div class="card h-100 @(goal.IsCompleted ? "goal-done" : "")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title fw-bold">@(goal.IsCompleted ? "✅ " : "")@goal.Title</h5>
                            </div>
                        
                            <p class="text-muted small mb-1">Цель: @goal.TargetAmount.ToString("N0") ₽</p>
                            <p class="mb-3 small">Накоплено: <strong>@saved.ToString("N0") ₽</strong></p>
                        
                            <div class="progress mb-2" style="height: 8px; border-radius: 10px;">
                                <div class="progress-bar @(goal.IsCompleted ? "bg-secondary" : "bg-success")"
                                     style="width: @progress.ToString().Replace(',', '.')%"></div>
                            </div>
                        
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <small class="fw-bold">@Math.Round(progress, 1)%</small>

                                @if (isReadyToComplete)
                                {
                                    <form asp-action="CompleteGoal" asp-route-id="@goal.Id" method="post">
                                        <button type="submit" class="btn btn-success btn-sm fw-bold shadow-sm">Завершить 🎉</button>
                                    </form>
                                }
                                else if (goal.IsCompleted)
                                {
                                    <span class="badge bg-secondary">Выполнено</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>