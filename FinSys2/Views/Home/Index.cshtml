@model List<FinSys2.Models.Transaction>
@{
    ViewData["Title"] = "Главная";
    bool isAuth = User.Identity.IsAuthenticated;
}

<div class="row">
    <div class="col-md-4">
        <div class="card p-4 shadow-sm mb-4">
            <h4 class="mb-4 text-primary">Новая запись</h4>
            @if (isAuth)
            {
                <form asp-action="AddTransaction" method="post" id="transForm">
                    <div class="mb-3">
                        <select name="type" id="typeSelect" class="form-select border-sky" onchange="updateCategories()">
                            <option value="Income">Доход (+)</option>
                            <option value="Expense" selected>Расход (-)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <input type="number" step="0.01" name="amount" class="form-control border-sky" placeholder="Сумма ₽" required>
                    </div>

                    <div class="mb-3">
                        <select id="categorySelect" class="form-select border-sky" onchange="checkOtherCategory()">
                        </select>
                        <input type="hidden" name="category" id="finalCategory">
                    </div>

                    <div class="mb-3" id="customCategoryBlock" style="display:none;">
                        <input type="text" id="customCategoryInput" class="form-control border-sky" placeholder="Назовите свою категорию">
                        <small class="text-danger" id="validationError" style="display:none;">Такая категория уже есть в списке!</small>
                    </div>

                    <div class="mb-3">
                        <input type="text" name="comment" class="form-control border-sky" placeholder="Комментарий">
                    </div>
                    <button type="submit" class="btn btn-sky w-100 fw-bold">Добавить</button>
                </form>

                <form asp-action="ClearAllData" method="post" onsubmit="return confirm('Очистить всю историю?')" class="mt-3">
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 border-0">🗑 Быстрая очистка истории</button>
                </form>
            }
            else
            {
                <div class="text-center p-3">
                    <p class="text-muted small">Войдите в аккаунт, чтобы сохранять историю и видеть графики.</p>
                </div>
            }
        </div>
    </div>

    <div class="col-md-8">
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card p-3 text-center border-0" style="background: #eef9ff;">
                    <small class="text-muted">Баланс</small>
                    <h3 class="fw-bold text-primary mb-0">@ViewBag.Balance.ToString("N0") ₽</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 text-center border-0">
                    <small class="text-muted text-success">Доходы</small>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalIncome.ToString("N0") ₽</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 text-center border-0">
                    <small class="text-muted text-danger">Расходы</small>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalExpense.ToString("N0") ₽</h3>
                </div>
            </div>
        </div>

        <div class="card p-4 mb-4">
            <h6 class="text-muted mb-3">Линейная диаграмма (Динамика накоплений)</h6>
            <canvas id="lineChart" style="max-height: 250px;"></canvas>
        </div>

        <div class="row mb-3">
            <div class="col-12">
                <div class="card p-3 shadow-sm border-0 bg-light">
                    <form method="get" asp-action="Index" class="d-flex align-items-end flex-wrap gap-2">
                        <div>
                            <label class="form-label text-muted small mb-1">Месяц</label>
                            <select name="month" class="form-select border-sky">
                                <option value="0" selected="@(ViewBag.SelectedMonth == 0)">Все месяцы</option>
                                <option value="1" selected="@(ViewBag.SelectedMonth == 1)">Январь</option>
                                <option value="2" selected="@(ViewBag.SelectedMonth == 2)">Февраль</option>
                                <option value="3" selected="@(ViewBag.SelectedMonth == 3)">Март</option>
                                <option value="4" selected="@(ViewBag.SelectedMonth == 4)">Апрель</option>
                                <option value="5" selected="@(ViewBag.SelectedMonth == 5)">Май</option>
                                <option value="6" selected="@(ViewBag.SelectedMonth == 6)">Июнь</option>
                                <option value="7" selected="@(ViewBag.SelectedMonth == 7)">Июль</option>
                                <option value="8" selected="@(ViewBag.SelectedMonth == 8)">Август</option>
                                <option value="9" selected="@(ViewBag.SelectedMonth == 9)">Сентябрь</option>
                                <option value="10" selected="@(ViewBag.SelectedMonth == 10)">Октябрь</option>
                                <option value="11" selected="@(ViewBag.SelectedMonth == 11)">Ноябрь</option>
                                <option value="12" selected="@(ViewBag.SelectedMonth == 12)">Декабрь</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label text-muted small mb-1">Год</label>
                            <select name="year" class="form-select border-sky">
                                <option value="0" selected="@(ViewBag.SelectedYear == 0)">Все время</option>
                                <option value="2024" selected="@(ViewBag.SelectedYear == 2024)">2024</option>
                                <option value="2025" selected="@(ViewBag.SelectedYear == 2025)">2025</option>
                                <option value="2026" selected="@(ViewBag.SelectedYear == 2026)">2026</option>
                            </select>
                        </div>
                        <div>
                            <button type="submit" class="btn btn-sky fw-bold">Применить фильтр</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card p-4 mb-4 shadow-sm border-0">
                    <h6 class="text-muted mb-3 text-center">Расходы по категориям</h6>
                    <canvas id="expenseChart"></canvas>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card p-4 mb-4 shadow-sm border-0">
                    <h6 class="text-muted mb-3 text-center">Зачисления по категориям</h6>
                    <canvas id="incomeChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Логика выпадающих списков динамических категорий
        const incomeCats = ["Зарплата", "Переводы", "Прибыль с бизнеса"];
        const expenseCats = ["Еда", "Здоровье", "Спорт", "Кинотеатр", "Видеоигры"];

        function updateCategories() {
            const type = document.getElementById('typeSelect').value;
            const select = document.getElementById('categorySelect');
            const list = type === "Income" ? incomeCats : expenseCats;

            select.innerHTML = '';
            list.forEach(cat => {
                select.innerHTML += `<option value="${cat}">${cat}</option>`;
            });
            select.innerHTML += `<option value="Other">Другая категория...</option>`;

            checkOtherCategory(); // Скрываем или показываем поле ввода кастомной категории
        }

        function checkOtherCategory() {
            const select = document.getElementById('categorySelect');
            const customBlock = document.getElementById('customCategoryBlock');
            customBlock.style.display = select.value === "Other" ? "block" : "none";
        }

        // Проверка кастомных категорий перед отправкой формы
        document.getElementById('transForm').onsubmit = function(e) {
            const select = document.getElementById('categorySelect');
            const customInput = document.getElementById('customCategoryInput');
            const type = document.getElementById('typeSelect').value;
            const list = type === "Income" ? incomeCats : expenseCats;

            let finalValue = select.value;

            if (select.value === "Other") {
                const val = customInput.value.trim();
                if (!val) {
                    alert("Введите название своей категории");
                    return false;
                }
                // Проверка на дубликат внутри массивов
                if (list.some(c => c.toLowerCase() === val.toLowerCase())) {
                    document.getElementById('validationError').style.display = 'block';
                    return false;
                }
                finalValue = val;
            }

            document.getElementById('finalCategory').value = finalValue;
        };

        // Инициализация категорий при первичной загрузке страницы
        updateCategories();

        // РЕНДЕРИНГ ГРАФИКОВ (Chart.js)

        // Линейный график динамики накоплений
        new Chart(document.getElementById('lineChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.ChartLabels)),
                datasets: [{
                    label: 'Баланс',
                    data: @Html.Raw(Json.Serialize(ViewBag.ChartValues)),
                    borderColor: '#00BFFF',
                    backgroundColor: 'rgba(0, 191, 255, 0.1)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: { scales: { y: { beginAtZero: true } } }
        });

        // Настройки для круговых диаграмм
        const pieOptions = {
            plugins: { legend: { position: 'bottom' } },
            cutout: '65%'
        };

        // Круговой график расходов
        new Chart(document.getElementById('expenseChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.ExpenseLabels)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(ViewBag.ExpenseValues)),
                    backgroundColor: ['#ff7675', '#74b9ff', '#a29bfe', '#ffeaa7', '#fab1a0', '#55efc4']
                }]
            },
            options: pieOptions
        });

        // Круговой график доходов
        new Chart(document.getElementById('incomeChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.IncomeLabels)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(ViewBag.IncomeValues)),
                    backgroundColor: ['#2ecc71', '#27ae60', '#1abc9c', '#16a085', '#a2d9ce']
                }]
            },
            options: pieOptions
        });
    </script>
}