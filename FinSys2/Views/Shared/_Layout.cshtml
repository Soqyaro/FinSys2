@using System.Security.Claims
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinSys2</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-custom mb-3 shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand text-white fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-wallet2 me-2"></i>FinSys2
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="Index">Главная</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="History" asp-action="Index">История</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Goals" asp-action="Index">Цели</a></li>
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            var avatarPath = User.FindFirst("AvatarPath")?.Value ?? "/images/default-avatar.jpg";

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center text-white" href="#" id="userMenu" role="button" data-bs-toggle="dropdown">
                                    <span class="fw-medium">@User.Identity.Name</span>
                                    <img src="@avatarPath" class="rounded-circle shadow-sm ms-2"
                                         style="width: 32px; height: 32px; object-fit: cover; border: 1px solid rgba(255,255,255,0.3);"
                                         alt="Avatar">
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="Settings">
                                            <i class="bi bi-gear me-2 text-muted"></i> Настройки
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger d-flex align-items-center" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Выйти
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold" href="#" data-bs-toggle="modal" data-bs-target="#loginModal">Вход</a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-light text-primary fw-bold px-3 shadow-sm" style="border-radius: 20px;" href="#" data-bs-toggle="modal" data-bs-target="#regModal">Регистрация</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        <div class="container pb-4">
            @RenderBody()
        </div>
    </main>

    <footer class="footer border-top text-muted bg-light">
        <div class="container text-center py-3">
            &copy; 2026 — <span class="text-primary fw-bold">FinSys2</span> • Твой личный финансовый помощник
        </div>
    </footer>

    <div class="modal fade" id="loginModal" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <form asp-controller="Account" asp-action="Login" method="post" class="modal-body p-4">
                    <h5 class="fw-bold mb-3">С возвращением!</h5>
                    <div class="mb-2">
                        <input type="email" name="email" class="form-control" placeholder="Email" required>
                    </div>
                    <div class="mb-3">
                        <input type="password" name="password" class="form-control" placeholder="Пароль" required>
                    </div>
                    <button type="submit" class="btn btn-sky w-100 fw-bold">Войти</button>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="regModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <form asp-controller="Account" asp-action="Register" method="post" class="modal-body p-4">
                    <h5 class="fw-bold mb-3">Создать аккаунт</h5>
                    <input type="text" name="FullName" class="form-control mb-2" placeholder="ФИО" pattern="[A-Za-zА-Яа-яЁё0-9 ]+" title="Используйте только латинские буквы" required>
                    <input type="email" name="Email" class="form-control mb-2" placeholder="Email" required>
                    <input type="password" name="Password" class="form-control mb-3" placeholder="Пароль" pattern="[A-Za-z0-9!@@#\$%\^\*\+\-\=\?]+" required>
                    <button type="submit" class="btn btn-sky w-100 fw-bold">Зарегистрироваться</button>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>